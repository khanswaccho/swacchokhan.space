<!doctype html>
<html lang="en-BD">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="robots" content="noindex">
  <title><%= status %> — <%= title %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <div class="ambience" aria-hidden="true">
    <div class="ambience__grid"></div>
    <div class="ambience__blob ambience__blob--1"></div>
    <div class="ambience__blob ambience__blob--2"></div>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <%- include('../partials/icons') %>

  <main class="error-page" id="main">
    <div class="shell">
      <span class="error-code"><%= status %></span>
      <h1 style="font-size:clamp(1.6rem,1.2rem+1.8vw,2.4rem);margin-top:1.5rem"><%= title %></h1>
      <p class="lede" style="margin:1.15rem auto 2.25rem;text-align:center"><%= message %></p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">
          Back to the start
          <svg class="btn__arrow" aria-hidden="true"><use href="#i-arrow-right"></use></svg>
        </a>
        <a class="btn btn--ghost" href="/contact">
          <svg aria-hidden="true"><use href="#i-mail"></use></svg>
          Tell me it's broken
        </a>
      </div>
    </div>
  </main>
</body>
</html>
