# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# Canonical public origin, no trailing slash — e.g. https://swacchokhan.space
# Used for canonical URLs, the sitemap and social preview links. Set this in
# production; without it the app trusts the Host header.
SITE_ORIGIN=

# Number of reverse proxies in front of the app (Render/Railway/Vercel = 1).
TRUST_PROXY_HOPS=1

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production. At least 32 characters of random hex.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=

# Extra hostnames allowed to POST to /api (comma separated). Your own host is
# always allowed; only add entries here if you serve the site from more than one.
ALLOWED_ORIGINS=

# Set to 1 to send Secure cookies while testing over local HTTPS.
FORCE_SECURE_COOKIES=0

# ── Contact form delivery ─────────────────────────────────────────────────────
# Leave SMTP_* empty and messages are appended to data/messages.log.jsonl
# instead — the form still works, nothing is lost.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
CONTACT_TO=khanswaccho@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Optional. A fine-grained token with *no* scopes raises the API rate limit
# from 60/hour to 5000/hour. It is only ever used server-side.
GITHUB_TOKEN=
GITHUB_CACHE_MINUTES=30

# Repos to pin to the front of the portfolio grid, in order, comma separated.
PINNED_REPOS=
